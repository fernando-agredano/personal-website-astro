---
import "@/styles/globals.css";
import PortfolioApp from "@/components/PortfolioApp";
---

<!doctype html>
<html lang="en" class="dark" suppressHydrationWarning>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Premium dark portfolio of Fernando, Software Engineer specializing in high-performance web applications."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>Fernando | Software Engineer Portfolio</title>
  </head>
  <body class="antialiased selection:bg-accent-blue selection:text-premium-black">
    <PortfolioApp client:load />
  </body>
</html>
